/* Style global UniShare */
QMainWindow {
    background-color: #f0f2f5;
}

QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 8px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton#danger {
    background-color: #e74c3c;
}

QPushButton#danger:hover {
    background-color: #c0392b;
}

QLineEdit {
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 10px;
    background-color: white;
}

QLineEdit:focus {
    border: 1px solid #3498db;
}

QLabel {
    color: #2c3e50;
}

QListWidget {
    background-color: #f8f9fa;
    border: none;
    padding: 10px;
}

QListWidget::item {
    padding: 5px;
}

QToolBar {
    background-color: white;
    border-top: 1px solid #ddd;
    spacing: 10px;
    padding: 5px;
}

QToolBar QPushButton {
    background-color: transparent;
    border: none;
    font-size: 20px;
    padding: 10px;
}

QToolBar QPushButton:hover {
    background-color: #f0f0f0;
    border-radius: 10px;
}